class BankAccount
{
    // data members (attributes)
    String accountHolderName;
    long accountNumber;
    String accountType;
    double accountBalance;

    // constructor to initialize account details
    BankAccount(String name, long accNo, String type, double balance)
    {
        accountHolderName = name;
        accountNumber = accNo;
        accountType = type;
        accountBalance = balance;
    }

    // method to deposit money
    void deposit(double amount)
    {
        if (amount > 0)
        {
            accountBalance = accountBalance + amount;
            System.out.println(amount + " deposited successfully.");
        }
        else
        {
            System.out.println("Invalid deposit amount");
        }
    }

    // method to withdraw money
    void withdraw(double amount)
    {
        if (amount <= 0)
        {
            System.out.println("Invalid withdraw amount");
        }
        else if (amount <= accountBalance)
        {
            accountBalance = accountBalance - amount;
            System.out.println(amount + " withdraw Successfully.");
        }
        else
        {
            System.out.println("Insufficient Balance.");
        }
    }

    // method to display current balance
    void balanceEnquiry()
    {
        System.out.println("Current Balance: " + accountBalance);
    }

    // method to display account information
    void display()
    {
        System.out.println("Account Holder : " + accountHolderName);
        System.out.println("Account Number : " + accountNumber);
        System.out.println("Account Type   : " + accountType);
        System.out.println("Balance        : " + accountBalance);
    }

    // main method
    public static void main(String[] args)
    {
        // Test case 1: Create account
        BankAccount acc1 = new BankAccount("Ravi", 1001L, "Savings", 10000);

        System.out.println("--- Initial Account Details ---");
        acc1.display();

        // Test case 2: Deposit valid amount
        System.out.println("\n--- Deposit 5000 ---");
        acc1.deposit(5000);
        acc1.balanceEnquiry();

        // Test case 3: Withdraw less than Balance
        System.out.println("\n--- Withdraw 3000 ---");
        acc1.withdraw(3000);
        acc1.balanceEnquiry();

        // Reset balance for further testing
        acc1.accountBalance = 10000;

        // Test case 4: Withdraw equal to Balance
        System.out.println("\n--- Withdraw Remaining Balance ---");
        acc1.withdraw(acc1.accountBalance);
        acc1.balanceEnquiry();

        // Reset balance for further testing
        acc1.accountBalance = 10000;

        // Test case 5: Withdraw greater than Balance
        System.out.println("\n--- Withdraw 15000 ---");
        acc1.withdraw(15000);

        // Test case 6: Balance Enquiry
        System.out.println("\n--- Balance Enquiry ---");
        acc1.balanceEnquiry();

        // Test case 7: Deposit zero
        System.out.println("\n--- Deposit 0 ---");
        acc1.deposit(0);

        // Test case 8: Deposit negative
        System.out.println("\n--- Deposit -500 ---");
        acc1.deposit(-500);

        // Test case 9: Withdraw zero
        System.out.println("\n--- Withdraw 0 ---");
        acc1.withdraw(0);
    }
}
